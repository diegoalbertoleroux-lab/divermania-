rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin(){return request.auth != null && (('role' in request.auth.token && request.auth.token.role == 'admin') || ('admin' in request.auth.token && request.auth.token.admin == true));}
  match /menu/{uid}/{filename} {
   allow read: if true;
   allow create,update: if admin() && request.auth.uid == uid && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
   allow delete: if admin();
  }
  match /{allPaths=**} {allow read,write: if false;}
 }
}
